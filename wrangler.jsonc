{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldmc",
  "account_id": "57aa35e0dc43d937ff4b9e1305aa3aa7",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "worldmc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "worldmc-next-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
