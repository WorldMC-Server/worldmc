{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldmc",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "account_id": "57aa35e0dc43d937ff4b9e1305aa3aa7",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "worldmc.net",
      "custom_domain": true,
      "zone_name": "worldmc.net"
    },
    {
      "pattern": "www.worldmc.net",
      "custom_domain": true,
      "zone_name": "worldmc.net"
    }
  ]
}
